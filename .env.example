# Database connection string (Neon / Vercel Postgres in prod, local Postgres in dev)
POSTGRES_URL=postgresql://127.0.0.1:5432/afcea_payload
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs (Vercel sends it as a Bearer token)
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
# Vercel Blob token for media uploads (leave empty for local disk storage)
BLOB_READ_WRITE_TOKEN=
# Luma calendar whose public events are synced into the Events collection
LUMA_CALENDAR_API_ID=cal-B3ppeWVbSPa2fCP
